# glyph: white and greys with one red. Meters run grey -> white -> red as load rises; the selected
# process is ink on red; shortcut letters and upload are red. Background is the terminal's.
theme[main_bg]=""
theme[main_fg]="#F2F2F2"
theme[title]="#F2F2F2"
theme[hi_fg]="#F50514"
theme[selected_bg]="#F50514"
theme[selected_fg]="#000000"
theme[inactive_fg]="#4A4A4A"
theme[graph_text]="#8C8C8C"
theme[meter_bg]="#2A2A2A"
theme[proc_misc]="#8C8C8C"
theme[cpu_box]="#2A2A2A"
theme[mem_box]="#2A2A2A"
theme[net_box]="#2A2A2A"
theme[proc_box]="#2A2A2A"
theme[div_line]="#2A2A2A"
theme[temp_start]="#8C8C8C"
theme[temp_mid]="#F2F2F2"
theme[temp_end]="#F50514"
theme[cpu_start]="#8C8C8C"
theme[cpu_mid]="#F2F2F2"
theme[cpu_end]="#F50514"
theme[free_start]="#2A2A2A"
theme[free_mid]="#4A4A4A"
theme[free_end]="#8C8C8C"
theme[cached_start]="#2A2A2A"
theme[cached_mid]="#4A4A4A"
theme[cached_end]="#8C8C8C"
theme[available_start]="#2A2A2A"
theme[available_mid]="#4A4A4A"
theme[available_end]="#8C8C8C"
theme[used_start]="#8C8C8C"
theme[used_mid]="#F2F2F2"
theme[used_end]="#F50514"
theme[download_start]="#4A4A4A"
theme[download_mid]="#8C8C8C"
theme[download_end]="#F2F2F2"
theme[upload_start]="#8C8C8C"
theme[upload_mid]="#F50514"
theme[upload_end]="#F50514"
theme[process_start]="#8C8C8C"
theme[process_mid]="#F2F2F2"
theme[process_end]="#F50514"
